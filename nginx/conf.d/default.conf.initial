# Initial config — HTTP only (use this BEFORE SSL cert is obtained)
# After cert is obtained, replace with default.conf
server {
    listen 80;
    server_name medhistry.com www.medhistry.com;

    # Let's Encrypt challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Proxy API while we wait for cert
    location /api/ {
        proxy_pass http://api:8000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /health {
        proxy_pass http://api:8000/health;
    }

    location / {
        return 200 '{"status": "MedHistry API is running (HTTP)"}';
        add_header Content-Type application/json;
    }
}
