#!/usr/bin/env bash
# sdd-new — bootstrap a new Spec-Driven Development project from the sdd-starter template.
#
# Usage:  sdd-new
# Then answer the prompts. The script creates a GitHub repo from your template,
# clones it, seeds the one-line pitch, opens your editor, and launches Claude Code
# with a kickoff prompt so the constitution interview starts immediately.

set -euo pipefail

# ─── defaults (edit once, live forever) ──────────────────────────────────────
DEFAULT_ORG="cloud-nolojik"
DEFAULT_TEMPLATE="cloud-nolojik/sdd-starter"
DEFAULT_VISIBILITY="private"        # private | public
DEFAULT_CLONE_DIR="${HOME}/Projects"
DEFAULT_EDITOR="${EDITOR:-code}"    # code (VS Code), cursor, webstorm, open
# ─────────────────────────────────────────────────────────────────────────────

C_BOLD="\033[1m"; C_DIM="\033[2m"; C_GREEN="\033[32m"; C_YELLOW="\033[33m"; C_RED="\033[31m"; C_RESET="\033[0m"

say()  { printf "${C_BOLD}%s${C_RESET}\n" "$*"; }
note() { printf "${C_DIM}%s${C_RESET}\n" "$*"; }
ok()   { printf "${C_GREEN}✓${C_RESET} %s\n" "$*"; }
warn() { printf "${C_YELLOW}!${C_RESET} %s\n" "$*"; }
die()  { printf "${C_RED}✗${C_RESET} %s\n" "$*" >&2; exit 1; }

ask() {
  # ask "prompt" "default" VAR_NAME
  local prompt="$1" default="$2" __var="$3" reply
  if [[ -n "$default" ]]; then
    read -r -p "$(printf "${C_BOLD}%s${C_RESET} [${C_DIM}%s${C_RESET}]: " "$prompt" "$default")" reply
    reply="${reply:-$default}"
  else
    read -r -p "$(printf "${C_BOLD}%s${C_RESET}: " "$prompt")" reply
    [[ -n "$reply" ]] || die "Required."
  fi
  printf -v "$__var" '%s' "$reply"
}

slugify() {
  # lowercase, replace non-alnum with -, collapse, trim
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'
}

# ─── prereqs ────────────────────────────────────────────────────────────────
say "Checking prerequisites…"
command -v git >/dev/null || die "git not found"
command -v gh  >/dev/null || die "gh (GitHub CLI) not found — install with: brew install gh"
gh auth status >/dev/null 2>&1 || die "Not logged in to gh — run: gh auth login"
ok "git + gh ready"
echo

# ─── interview ──────────────────────────────────────────────────────────────
say "Tell me about the project."
ask "Project name (human-friendly)" "" PROJECT_NAME
DEFAULT_SLUG="$(slugify "$PROJECT_NAME")"
ask "Repo slug" "$DEFAULT_SLUG" PROJECT_SLUG
ask "One-line pitch (what + for whom)" "" PITCH
ask "GitHub org/user" "$DEFAULT_ORG" GH_ORG
ask "Template repo (org/name)" "$DEFAULT_TEMPLATE" TEMPLATE_REPO
ask "Visibility (public/private)" "$DEFAULT_VISIBILITY" VISIBILITY
ask "Local clone parent dir" "$DEFAULT_CLONE_DIR" CLONE_PARENT
ask "Editor command (code, cursor, webstorm, open, or 'none')" "$DEFAULT_EDITOR" EDITOR_CMD
ask "Launch Claude Code automatically? (y/n)" "y" LAUNCH_CLAUDE

case "$VISIBILITY" in
  public|private) ;;
  *) die "visibility must be 'public' or 'private'" ;;
esac

FULL_REPO="${GH_ORG}/${PROJECT_SLUG}"
LOCAL_PATH="${CLONE_PARENT%/}/${PROJECT_SLUG}"

echo
say "Summary"
printf "  Repo       : %s\n" "$FULL_REPO"
printf "  Visibility : %s\n" "$VISIBILITY"
printf "  Template   : %s\n" "$TEMPLATE_REPO"
printf "  Clone to   : %s\n" "$LOCAL_PATH"
printf "  Editor     : %s\n" "$EDITOR_CMD"
printf "  Launch CC  : %s\n" "$LAUNCH_CLAUDE"
echo
ask "Proceed? (y/n)" "y" CONFIRM
[[ "$CONFIRM" =~ ^[Yy]$ ]] || die "Aborted."

# ─── create repo from template ──────────────────────────────────────────────
echo
say "Creating GitHub repo from template…"
mkdir -p "$CLONE_PARENT"
cd "$CLONE_PARENT"

if gh repo view "$FULL_REPO" >/dev/null 2>&1; then
  die "Repo $FULL_REPO already exists on GitHub."
fi
[[ -e "$LOCAL_PATH" ]] && die "Local path $LOCAL_PATH already exists."

gh repo create "$FULL_REPO" \
  --template "$TEMPLATE_REPO" \
  --"$VISIBILITY" \
  --clone \
  --description "$PITCH" \
  >/dev/null

ok "Created $FULL_REPO and cloned to $LOCAL_PATH"
cd "$LOCAL_PATH"

# ─── seed the mission pitch ─────────────────────────────────────────────────
if [[ -f specs/mission.md ]]; then
  # Insert the pitch under "## One-line pitch" (replaces the HTML comment placeholder)
  awk -v pitch="$PITCH" '
    BEGIN { done=0 }
    /^## One-line pitch/ && done==0 { print; print ""; print pitch; print ""; skip=1; done=1; next }
    skip==1 && /^## / { skip=0 }
    skip==1 { next }
    { print }
  ' specs/mission.md > specs/mission.md.new
  mv specs/mission.md.new specs/mission.md
  ok "Seeded one-line pitch into specs/mission.md"
else
  warn "specs/mission.md not found — template may have changed."
fi

# ─── kickoff prompt ─────────────────────────────────────────────────────────
KICKOFF_FILE=".sdd-kickoff.md"
cat > "$KICKOFF_FILE" <<EOF
# Kickoff for ${PROJECT_NAME}

You are starting a fresh project using this SDD template. Here's the context:

**Project name:** ${PROJECT_NAME}
**One-line pitch:** ${PITCH}
**Repo:** https://github.com/${FULL_REPO}

## What I want you to do now

1. Read CLAUDE.md and the three Constitution files (specs/mission.md, specs/tech-stack.md, specs/roadmap.md) to orient yourself.
2. Use the **constitution-init** skill. This is greenfield — interview me to fill in the mission, tech-stack, and roadmap.
3. Keep questions batched (≤4 per round). Don't invent defaults; use \`<!-- UNRESOLVED: … -->\` if I don't answer.
4. Commit the filled-in Constitution on a \`constitution-init\` branch. I'll review and merge before we touch any feature.

Start now.
EOF
ok "Wrote kickoff prompt to $KICKOFF_FILE"

# ─── commit the seed ────────────────────────────────────────────────────────
git add specs/mission.md "$KICKOFF_FILE" >/dev/null 2>&1 || true
if ! git diff --cached --quiet 2>/dev/null; then
  git -c commit.gpgsign=false commit -m "chore: seed mission pitch + kickoff prompt" >/dev/null
  git push --set-upstream origin "$(git rev-parse --abbrev-ref HEAD)" >/dev/null 2>&1 || warn "push failed — try manually"
  ok "Seed commit pushed"
fi

# ─── open editor ────────────────────────────────────────────────────────────
if [[ "$EDITOR_CMD" != "none" ]] && command -v "$EDITOR_CMD" >/dev/null 2>&1; then
  "$EDITOR_CMD" . &
  ok "Opened in $EDITOR_CMD"
elif [[ "$EDITOR_CMD" != "none" ]]; then
  warn "Editor '$EDITOR_CMD' not found — skipping."
fi

# ─── launch claude ──────────────────────────────────────────────────────────
echo
if [[ "$LAUNCH_CLAUDE" =~ ^[Yy]$ ]]; then
  if command -v claude >/dev/null 2>&1; then
    say "Launching Claude Code with the kickoff prompt…"
    note "(In Claude, read .sdd-kickoff.md and follow it.)"
    # Open claude in the repo with the kickoff file referenced
    exec claude "Read .sdd-kickoff.md in this repo and follow its instructions."
  else
    warn "claude CLI not found. Paste the kickoff into Claude Code yourself:"
    echo
    cat "$KICKOFF_FILE"
  fi
else
  say "Done. Next step:"
  note "  cd $LOCAL_PATH && claude \"Read .sdd-kickoff.md and follow it.\""
fi
